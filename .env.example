# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tmgyiphkwxnahgsapvsm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Public site URL (used in invitation links). On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email through Gmail with an App Password (~500 recipients/day on a regular account)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=
# EMAIL_DRY_RUN=1

# SMS through Twilio (stage 7). Use a Messaging Service SID, or a From number / approved sender ID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# SMS_DRY_RUN=1

# Vercel Cron authorization for /api/cron/reminders
CRON_SECRET=
# REMINDER_RUN_INTERVAL_HOURS=24
